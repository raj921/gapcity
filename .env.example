# Never prefix this secret with NEXT_PUBLIC_. Never commit .env.local.
SERPAPI_KEY=
# Live mode must be deliberately enabled, even when a key is present.
GAPCITY_LIVE_ENABLED=false
# Public visitors can use live search without an access code when explicitly enabled.
# SERPAPI_KEY and the signing secret still remain server-only.
GAPCITY_PUBLIC_LIVE=false
# Hard ceiling on outgoing attempts for this running process, including failures.
SERPAPI_MAX_CALLS=60
# Maps search pages per analysis, capped at three (60 raw results).
SERPAPI_SEARCH_PAGES=3
# Optional private-demo gate; ignored when GAPCITY_PUBLIC_LIVE=true.
# The user supplies it in the app's Live access field. It is not stored.
GAPCITY_LIVE_ACCESS_TOKEN=
# Required for production live mode. Generate with: openssl rand -hex 32
# Signs analysis snapshots so review requests work across serverless instances.
GAPCITY_SIGNING_SECRET=
